# ============================================================
# CyberTrack — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# REQUIRED: Google Gemini API Key
# ----------------------------------------------------------
# Get your key from: https://aistudio.google.com/app/apikey
# The /check-message endpoint uses this to generate plain-
# language fraud explanations via gemini-1.5-flash.
# If not set, the API falls back to a rule-based mock response.
GOOGLE_API_KEY=your_google_api_key_here

# ----------------------------------------------------------
# OPTIONAL: Override the default Gemini model
# ----------------------------------------------------------
# Options: gemini-1.5-flash (default, fast), gemini-1.5-pro (smarter)
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------------------------------------
# OPTIONAL: Enable trained ML models
# ----------------------------------------------------------
# Set to "true" AFTER running train.py to enable the
# SMS Naive Bayes + URL Logistic Regression classifiers.
# Default is "false" (rules-only mode, no dataset needed).
USE_ML_MODELS=false
