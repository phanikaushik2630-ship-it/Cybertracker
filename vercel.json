{
  "rewrites": [
    {
      "source": "/check-message",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|check-message|health).*)",
      "destination": "/index.html"
    }
  ]
}
